# Copy to .env and adjust. Never commit .env.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=.localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO

# Used by Docker Compose to create the database, and by Django to connect to it.
POSTGRES_DB=kalvione
POSTGRES_USER=kalvione
POSTGRES_PASSWORD=kalvione
# Inside Docker Compose the host is "db"; when running Django on your machine use "localhost".
DATABASE_URL=postgres://kalvione:kalvione@db:5432/kalvione

# Multi-tenancy: a college is served on <slug>.<base domain>, e.g. demo.localhost:8000
TENANT_BASE_DOMAINS=localhost
TENANT_PLATFORM_HOSTS=localhost,127.0.0.1
# Set only for a dedicated single-college deployment.
TENANT_DEDICATED_COLLEGE_SLUG=
